{% extends 'base.html.twig' %}

{% block title %}Invoice
{% endblock %}

{% block body %}
	<section class="flex h-screen w-full">
		<twig:AsideBar/>
		<main class="flex flex-col w-full p-8 gap-6 text-gray-500">
			<div class="flex flex-col py-6 px-40 gap-6">
                
                <a href="{{ path('app_invoice_index') }}" class="flex items-center gap-2 hover:text-blue-700">
					{{ ux_icon('lucide:arrow-left') }}
					<span>Retour aux factures</span>
				</a>

			    <div class='flex justify-between'>

                    {% set status = invoice.status.value %}
                                {% set badgeClass = 
                                    status == 'Draft' ? 'bg-gray-100 text-gray-800' :
                                    status == 'pending_payment' ? 'bg-blue-100 text-blue-800' :
                                    status == 'paid' ? 'bg-green-100 text-green-800' :
                                    status == 'cancelled' ? 'bg-red-100 text-red-800' :
                                    'bg-gray-100 text-gray-800'
                                %}
                    <div>
                        <h1 class='text-2xl font-bold text-black'> FACTURE {{invoice.number}}
                        <span class="px-2 py-1 text-xs font-medium rounded-full {{ badgeClass }}">
                                {{ status }}
                        </span></h1>
                        <p>Date: {{invoice.createdAt| date('y/m/d')}}
                    </div>
                    <div class='flex gap-2'>
                        <form method="post" action="{{ path('app_invoice_delete', {'id': invoice.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ invoice.id) }}">
                            <button class=" hover:text-red-700 transition border bg-white flex gap-2 px-2 py-1 rounded-md">
                                Suprimer {{ ux_icon('lucide:trash-2', {height: 20, width: 20}) }}
                            </button>
                        </form>
                    </div>
                </div>

                <div class='flex flex-col text-black w-full shadow-md p-10 gap-10'>

                    <div class='flex justify-between'>
                        <div>
                            <h1>{{user.companyName}}</h1>
                            <p>{{user.firstName}} {{user.lastName}}</p>
                            <p>{{user.email}}</p>
                        </div>
                        <div>
                            <h1>FACTURE </h1>
                            <p>N° {{invoice.number}} </p>
                            <p>Date: {{invoice.createdAt|date('y/m/d')}}</p>
                        </div>
                    </div>

                    <div class='bg-gray-300 inline-block self-end-safe rounded-md p-4 '>
                        <h1 class="p-1">FACTURÉ A </h1>
                        <p class="text-black p-1 font-bold, w-md"> {{invoice.client.name}} </p>
                        <p class="p-1">{{invoice.client.address}}</p>
                        <p class="p-1">{{invoice.client.email}}</p>
                        <p class="p-1">{{invoice.client.siret}}</p>

                    </div>

                        <div class='flex flex-col gap-2 bg-white p-6 rounded-md shadow-sm'>
        <h2 class=' text-2xl font-bold text-black'>Lignes de la facture</h2>

		<div class="py-4 w-full">
            <table class="table-auto w-full">
                <thead class='border-b-2 border-black'>
                    <tr>
                        <th class='px-4 py-2 text-left'>Produit/Service</th>
                        <th class='px-4 py-2 text-left'>Qté</th>
                        <th class='px-4 py-2 text-left'>Prix unitaire</th>
                        <th class='px-4 py-2 text-left'>Total</th>
                        
                    </tr>
                </thead>
                <tbody>
                {{ dump(invoice.invoiceItems|length) }}
                    {% for item in invoice.invoiceItems %}
                        <tr>
                            <td class='px-4 py-2'>{{ item.product.name }}</td>
                            <td class='px-4 py-2'>{{ item.quantity }}</td>
                            <td class='px-4 py-2'>{{ item.unitPrice }} €</td>
                            <td class='px-4 py-2'>{{ item.quantity * item.unitPrice }}€</td>
                            
						</tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

                    



                </div>

                

				<table class="table">
					<tbody>
						<tr>
							<th>Id</th>
							<td>{{ invoice.id }}</td>
						</tr>
						<tr>
							<th>Number</th>
							<td>{{ invoice.number }}</td>
						</tr>
						<tr>
							<th>Total_ttc</th>
							<td>{{ invoice.totalTtc }}</td>
						</tr>
						<tr>
							<th>Created_at</th>
							<td>{{ invoice.createdAt ? invoice.createdAt|date('Y-m-d H:i:s') : '' }}</td>
						</tr>
						<tr>
							<th>Status</th>
							<td>{{ invoice.status.value }}</td>
						</tr>
					</tbody>
				</table>


				<a href="{{ path('app_invoice_edit', {'id': invoice.id}) }}">edit</a>


			</div>
			</div>

		</main>
	</section>


{% endblock %}
